{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:route-engine:dsl:1",
  "title": "Route Engine finite DSL v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routeId",
    "version",
    "dslVersion",
    "engineSemanticsVersion",
    "adapterContractVersion",
    "root"
  ],
  "properties": {
    "routeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "dslVersion": {
      "const": "1"
    },
    "engineSemanticsVersion": {
      "const": "1"
    },
    "adapterContractVersion": {
      "const": "1"
    },
    "inputSchema": {
      "allOf": [
        {
          "$ref": "#/$defs/valueSchema"
        },
        {
          "properties": {
            "type": {
              "const": "object"
            }
          }
        }
      ]
    },
    "root": {
      "$ref": "#/$defs/sequence"
    }
  },
  "$defs": {
    "valueSchema": {
      "oneOf": [
        {
          "type": "object",
          "maxProperties": 0
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "string",
                "boolean",
                "number",
                "integer"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "object"
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/valueSchema"
              }
            },
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
              }
            },
            "additionalProperties": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^(input|steps\\.[A-Za-z][A-Za-z0-9_-]{0,127})(\\.[A-Za-z][A-Za-z0-9_-]{0,127})+$"
        },
        "operator": {
          "enum": [
            "EQ",
            "NE",
            "LT",
            "LE",
            "GT",
            "GE",
            "EXISTS"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "EXISTS"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "value"
              ]
            }
          },
          "else": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "inputValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inputValue"
          }
        },
        {
          "type": "object",
          "not": {
            "required": [
              "$ref"
            ]
          },
          "additionalProperties": {
            "$ref": "#/$defs/inputValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "$ref"
          ],
          "properties": {
            "$ref": {
              "type": "string",
              "pattern": "^(input|steps\\.[A-Za-z][A-Za-z0-9_-]{0,127})(\\.[A-Za-z][A-Za-z0-9_-]{0,127})+$"
            }
          }
        }
      ]
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxAttempts",
        "maxElapsedSeconds",
        "backoffSeconds"
      ],
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxElapsedSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 604800
        },
        "backoffSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "maxBackoffSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      }
    },
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointRef",
        "maxAttempts"
      ],
      "properties": {
        "endpointRef": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "children"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "when": {
          "$ref": "#/$defs/comparison"
        },
        "type": {
          "const": "SEQUENCE"
        },
        "children": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "join",
        "branches"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "when": {
          "$ref": "#/$defs/comparison"
        },
        "type": {
          "const": "PARALLEL"
        },
        "join": {
          "const": "ALL_SETTLED"
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "condition",
        "then",
        "else"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
        },
        "when": {
          "$ref": "#/$defs/comparison"
        },
        "type": {
          "const": "CONDITION"
        },
        "condition": {
          "$ref": "#/$defs/comparison"
        },
        "then": {
          "$ref": "#/$defs/node"
        },
        "else": {
          "$ref": "#/$defs/node"
        }
      }
    },
    "activity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "endpointRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "REST"
            },
            "endpointRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "rollback": {
              "$ref": "#/$defs/compensation"
            },
            "onFailure": {
              "$ref": "#/$defs/notification"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "resourceRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "KUBERNETES"
            },
            "resourceRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "rollback": {
              "$ref": "#/$defs/compensation"
            },
            "onFailure": {
              "$ref": "#/$defs/notification"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "playbookRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "ANSIBLE"
            },
            "playbookRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            },
            "rollback": {
              "$ref": "#/$defs/compensation"
            },
            "onFailure": {
              "$ref": "#/$defs/notification"
            }
          }
        }
      ]
    },
    "compensation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "endpointRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "REST"
            },
            "endpointRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "resourceRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "KUBERNETES"
            },
            "resourceRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "playbookRef"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,127}$"
            },
            "when": {
              "$ref": "#/$defs/comparison"
            },
            "type": {
              "const": "ANSIBLE"
            },
            "playbookRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "input": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/inputValue"
              }
            },
            "outputSchema": {
              "$ref": "#/$defs/valueSchema"
            },
            "artifactDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "credentialRef": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
            },
            "retry": {
              "$ref": "#/$defs/retry"
            }
          }
        }
      ]
    },
    "node": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "SEQUENCE",
            "CONDITION",
            "PARALLEL",
            "REST",
            "KUBERNETES",
            "ANSIBLE"
          ]
        }
      },
      "oneOf": [
        {
          "$ref": "#/$defs/sequence"
        },
        {
          "$ref": "#/$defs/parallel"
        },
        {
          "$ref": "#/$defs/condition"
        },
        {
          "$ref": "#/$defs/activity"
        }
      ]
    }
  },
  "x-semantic-validation": "DefinitionRules additionally enforces unique IDs, at most 100 total nodes including rollback, structure depth 20, no nested parallel, backward typed references scoped to each branch, required properties for value bindings, numeric comparisons, retry cap >= initial backoff, and 262144 UTF-8 bytes."
}
